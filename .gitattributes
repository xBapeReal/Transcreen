# Normalize text to LF in the repository and in checkouts (matches .editorconfig);
# Windows batch/PowerShell files keep CRLF, which cmd.exe needs for labels.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.gif binary
*.webp binary

# README media stays out of release/source archives (users only need the app).
docs/ export-ignore
